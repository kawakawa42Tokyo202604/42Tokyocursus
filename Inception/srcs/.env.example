DOMAIN_NAME=takawaka.42.fr
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_EMAIL=
WORDPRESS_USER=
WORDPRESS_USER_EMAIL=
FTP_USER=ftpuser
ADMIN_BIND_ADDRESS=127.0.0.1
FTP_PASV_ADDRESS=127.0.0.1
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION=7

# Passwords are stored in ../secrets/*.txt, not in this file.
# Adminer and FTP listen on the VM loopback address by default.
# Keep the passive address at 127.0.0.1 for VM-local clients or SSH tunnels.
# Set FTP_PASV_ADDRESS to the IP address clients use to reach the Docker host.
# BACKUP_SCHEDULE uses the five-field cron format. BACKUP_RETENTION is the
# number of completed backup generations to keep.
